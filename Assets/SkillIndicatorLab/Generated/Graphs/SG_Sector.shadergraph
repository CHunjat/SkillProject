{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b497e896eb574c52af00dc35ae43bead",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SkillTelegraph (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 0.0,
            "y": 0.0,
            "width": 220.0,
            "height": 150.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "9ec1aa568a544561b20925469ceb8565"
        },
        {
            "m_Id": "b1b97d8bad754c9dbe4ae686fd9ffc7a"
        },
        {
            "m_Id": "5bccd88d742b4f89ac0e16b8403df4db"
        },
        {
            "m_Id": "0e597fc0090940c6b5239bc6e8737b72"
        },
        {
            "m_Id": "47fe57c31c41414db8832350f7824535"
        },
        {
            "m_Id": "54e45b8bd0974076be36e441bd1bcdb2"
        },
        {
            "m_Id": "4cfa0650fab74fe6a491d9385f7909db"
        },
        {
            "m_Id": "6d59959fc0fc45c88528e992a2087f70"
        },
        {
            "m_Id": "4acd8bf988e54c31894d8ce924125c17"
        },
        {
            "m_Id": "42050097cc03455187198ba61fcc0f5d"
        },
        {
            "m_Id": "e6f99924f1604a948df138fdec17eba4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SkillTelegraph",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\nfloat2 p = UV * 2.0 - 1.0;\nfloat r = length(p);\nfloat a = abs(atan2(p.x, p.y));\nfloat halfAngle = radians(clamp(Angle, 1.0, 359.0) * 0.5);\nfloat sd = r - 1.0;\nfloat travel = r;\nif (Shape > 0.5 && Shape < 1.5) { sd = max(abs(p.x), abs(p.y)) - 1.0; travel = UV.y; }\nif (Shape > 1.5 && Shape < 2.5) { sd = max(sd, (a - halfAngle) * max(r, 0.001)); }\nif (Shape > 2.5) { sd = max(sd, Inner - r); travel = saturate((r - Inner) / max(1.0 - Inner, 0.01)); }\nfloat aa = max(fwidth(sd), 0.002);\nfloat mask = 1.0 - smoothstep(-aa, aa, sd);\nfloat edge = mask * smoothstep(-Border - aa, -Border + aa, sd);\nfloat fill = (1.0 - smoothstep(Progress - 0.012, Progress + 0.012, travel)) * step(0.001, Progress);\nfloat front = (1.0 - smoothstep(0.0, 0.022, abs(travel - Progress))) * step(0.001, Progress);\nfloat accents = 0.0;\nif (Shape > 0.5 && Shape < 1.5) {\n    float chevron = abs(frac(UV.y * 4.0 + abs(p.x) * 0.32) - 0.5);\n    accents = (1.0 - smoothstep(0.02, 0.045, chevron)) * 0.25 * fill;\n}\nColor = lerp(Tint.rgb, float3(1,1,1), saturate(edge * 0.3 + front * 0.35 + Impact * 0.8));\nAlpha = saturate(mask * (0.08 + fill * 0.3 + front * 0.4 + accents + Impact * 0.32) + edge * 0.8) * Tint.a * Opacity;\n"
}

